<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Airspace Radar - Desktop Console" Width="1080" Height="780" MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#0D1015" Foreground="#E6EDF5"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#151A22"/>
    <SolidColorBrush x:Key="Field" Color="#0E131A"/>
    <SolidColorBrush x:Key="Edge" Color="#293341"/>
    <SolidColorBrush x:Key="Text" Color="#E6EDF5"/>
    <SolidColorBrush x:Key="Muted" Color="#9DAABC"/>
    <SolidColorBrush x:Key="Accent" Color="#70DCCE"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#212936"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#7EA6AE"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#70DCCE"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#101C1E"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="5,0,0,0"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{x:Null}">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="5,0,0,0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24,18,24,20">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True">
      <Border DockPanel.Dock="Right" Background="#17222B" CornerRadius="5" Padding="12,7" VerticalAlignment="Center">
        <TextBlock x:Name="RunStatus" Foreground="{StaticResource Accent}" Text="Ready" FontWeight="SemiBold"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="AIRSPACE   /   XIAO ESP32C6" Style="{StaticResource Hint}" FontFamily="Consolas"/>
        <TextBlock Text="Airspace Radar" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0"/>
      </StackPanel>
    </DockPanel>
    <Grid x:Name="SettingsContent" Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
              <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="Apply and start"/>
              <Button x:Name="StopButton" Grid.Column="2" Content="Stop" IsEnabled="False"/>
            </Grid>
            <TextBlock x:Name="SettingsNote" Style="{StaticResource Hint}" Text="Settings are saved locally when applied." TextWrapping="Wrap" Margin="0,7,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,15,16,0">
              <TextBlock Style="{StaticResource Section}" Text="01  Map area"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,7,0">
                  <TextBlock x:Name="AirportCode" Text="JFK" FontSize="26" FontFamily="Consolas"/>
                  <TextBlock x:Name="AirportName" TextWrapping="Wrap" Style="{StaticResource Hint}" MaxHeight="38"/>
                </StackPanel>
                <Button x:Name="ChooseAirport" Grid.Column="1" Content="Change airport" VerticalAlignment="Top"/>
              </Grid>
              <TextBlock x:Name="AirportCoords" Style="{StaticResource Hint}" FontFamily="Consolas" Margin="0,5,0,11"/>
              <Label Target="{Binding ElementName=SpanBox}" Content="View width (km)" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/>
              <TextBox x:Name="SpanBox" Text="100" MaxLength="4"/>
              <WrapPanel Margin="0,12,0,0">
                <CheckBox x:Name="RunwaysBox" Content="Runways" IsChecked="True" Margin="0,0,13,0"/>
                <CheckBox x:Name="NavaidsBox" Content="Navaids" IsChecked="True" Margin="0,0,13,0"/>
                <CheckBox x:Name="TrailsBox" Content="Trails" IsChecked="True" Margin="0,0,13,0"/>
                <CheckBox x:Name="TiltedBox" Content="3D view" IsChecked="True" Margin="0,0,13,0"/>
                <CheckBox x:Name="WaterLinesBox" Content="Water outlines" IsChecked="True"/>
              </WrapPanel>
              <Border Background="{StaticResource Edge}" Height="1" Margin="0,16,0,14"/>
              <TextBlock Style="{StaticResource Section}" Text="02  Data and refresh"/>
              <WrapPanel Margin="0,0,0,12">
                <RadioButton x:Name="LiveMode" GroupName="Source" Content="OpenSky live" IsChecked="True" Margin="0,0,16,0"/>
                <RadioButton x:Name="DemoMode" GroupName="Source" Content="Offline demo"/>
              </WrapPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,6,0">
                  <Label Target="{Binding ElementName=PollBox}" Content="Fetch interval (s)" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/>
                  <TextBox x:Name="PollBox" Text="20" MaxLength="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                  <Label Target="{Binding ElementName=RenderBox}" Content="Render interval (s)" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/>
                  <TextBox x:Name="RenderBox" Text="2" MaxLength="2"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="PollHint" Style="{StaticResource Hint}" Text="The PC fetches data. The board renders the scene." TextWrapping="Wrap" Margin="0,7,0,0"/>
              <Border Background="{StaticResource Edge}" Height="1" Margin="0,16,0,14"/>
              <TextBlock Style="{StaticResource Section}" Text="03  Output"/>
              <CheckBox x:Name="UsbBox" Content="Send to USB display" IsChecked="False"/>
              <Grid Margin="0,8,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="PortBox" MinHeight="30" Foreground="#121922" Background="#DDE5ED" VerticalContentAlignment="Center" AutomationProperties.Name="Serial port"/>
                <Button x:Name="RefreshPorts" Grid.Column="2" Content="Refresh" MinHeight="30" Padding="8,3"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" Padding="17,14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,11">
            <TextBlock DockPanel.Dock="Right" Text="240 × 240" FontFamily="Consolas" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
            <TextBlock x:Name="MapHeading" Text="Display preview" FontSize="16" FontWeight="SemiBold"/>
          </DockPanel>
          <Border Grid.Row="1" Background="#090C11" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
              <Image x:Name="FrameImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Radar preview"/>
              <TextBlock x:Name="FrameEmpty" Text="Preparing preview..." Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <UniformGrid Grid.Row="2" Columns="3" Margin="0,12,0,10">
            <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Aircraft in view"/><TextBlock x:Name="AircraftValue" Text="—" FontSize="22" FontFamily="Consolas"/></StackPanel>
            <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Next fetch"/><TextBlock x:Name="PollValue" Text="—" FontSize="22" FontFamily="Consolas"/></StackPanel>
            <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Credits left"/><TextBlock x:Name="QuotaValue" Text="—" FontSize="22" FontFamily="Consolas"/></StackPanel>
          </UniformGrid>
          <StackPanel Grid.Row="3">
            <TextBlock x:Name="RunDetail" Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Try the offline demo to check the layout."/>
            <Expander Header="Run log" Foreground="{StaticResource Muted}" Margin="0,5,0,0">
              <TextBox x:Name="LogBox" Height="96" Margin="0,5,0,0" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </Expander>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid x:Name="Picker" Grid.RowSpan="2" Background="#DB0A0C10" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="610" MaxHeight="580" Margin="10" Padding="19" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource Panel}" BorderBrush="#4C6772" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <Button x:Name="ClosePicker" DockPanel.Dock="Right" Content="Cancel" MinHeight="30"/>
            <TextBlock Text="Choose airport" FontSize="23" FontWeight="SemiBold"/>
          </DockPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Label Target="{Binding ElementName=AirportSearch}" Content="Airport code, name or city" Foreground="{StaticResource Muted}" Padding="0,0,0,4"/>
            <TextBox x:Name="AirportSearch" MaxLength="80"/>
            <TextBlock x:Name="SearchCount" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
          </StackPanel>
          <ListBox x:Name="AirportResults" Grid.Row="2" Height="225" Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}" Foreground="{StaticResource Text}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1E2B37"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#24404A"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Codes}" FontFamily="Consolas" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Place}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="3" x:Name="SelectAirport" Content="Use selected airport" HorizontalAlignment="Right" Margin="0,8,0,0" Style="{StaticResource Primary}"/>
          <Expander Grid.Row="4" Header="Or enter a custom map center" Foreground="{StaticResource Muted}" Margin="0,11,0,0">
            <StackPanel Margin="0,5,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><Label Target="{Binding ElementName=LatitudeBox}" Content="Latitude (-90 to 90)" Foreground="{StaticResource Muted}" Padding="0,0,0,4"/><TextBox x:Name="LatitudeBox" MaxLength="18"/></StackPanel>
                <StackPanel Grid.Column="2"><Label Target="{Binding ElementName=LongitudeBox}" Content="Longitude (-180 to 180)" Foreground="{StaticResource Muted}" Padding="0,0,0,4"/><TextBox x:Name="LongitudeBox" MaxLength="18"/></StackPanel>
                <Button Grid.Column="4" x:Name="UseCoordinates" Content="Use coordinates" VerticalAlignment="Bottom" MinHeight="30"/>
              </Grid>
              <TextBlock x:Name="CoordError" Foreground="#FFA79E" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Expander>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
